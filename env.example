# SHYAM SUPER APP Backend Environment Variables

# Database Configuration
MONGO_URI=mongodb://localhost:27017/shyam-super-app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=4000
NODE_ENV=development

# File Upload Configuration (Optional)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Security Configuration (Optional)
BCRYPT_SALT_ROUNDS=10

# API Configuration (Optional)
API_VERSION=v1
API_PREFIX=/api

# CORS Configuration (Optional)
CORS_ORIGIN=*

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Default Director User (Created automatically if no users exist)
DEFAULT_DIRECTOR_NAME=John Director
DEFAULT_DIRECTOR_ALIAS=Director
DEFAULT_DIRECTOR_EMAIL=director@shyam.com
DEFAULT_DIRECTOR_PASSWORD=Director123
